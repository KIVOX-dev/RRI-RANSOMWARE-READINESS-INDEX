ENVIRONMENT=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=rri

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=rri_minio_admin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_EVIDENCE=rri-evidence
MINIO_BUCKET_REPORTS=rri-reports
MINIO_SECURE=false

# Auth
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000

# Ed25519 ledger signing key (base64) — leave blank to auto-generate on first boot (dev only)
LEDGER_PRIVATE_KEY_B64=

# OpenRouter (optional LLM plain-language assist — presentation only, never affects scores)
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FALLBACK_MODELS=mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free

# Optional Hyperledger Fabric integrity-ledger stretch anchor. The signed
# hash chain (see LedgerEntry model) is the application's default integrity
# mechanism and works with or without this — set FABRIC_ENABLED=false to
# disable the extra on-chain anchor call entirely.
FABRIC_ENABLED=true
FABRIC_GATEWAY_URL=http://localhost:3001
